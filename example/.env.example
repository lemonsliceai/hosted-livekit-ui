# LemonSlice API key
LEMONSLICE_API_KEY=

# LemonSlice rooms endpoint.
LEMONSLICE_API_URL=https://lemonslice.com/api/liveai/rooms

# Optional. Set when LEMONSLICE_API_URL does not end in /rooms (e.g. a Modal endpoint).
# LEMONSLICE_AVATAR_VARIANT_URL=

# Optional. Sent as livekit_agent_name_override. Leave unset for the default agent.
# LEMONSLICE_LIVEKIT_AGENT_NAME=lemonslice-hosted-agent-dev

# Where LemonSlice sends session.usage and session.ended.
# For the test app use ngrok http 3010
# Leave blank to turn webhooks off.
WEBHOOK_URL=

# Demo only: the webhook replies terminate=true once a session passes this many credits.
# TERMINATE_AFTER_CREDITS=100
